* text=auto
# Windows PowerShell 5.1 runs these; keep CRLF in the working tree on every OS
# (the template's {$PKI.SCRIPT.MD5} is the MD5 of the CRLF file).
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.conf text eol=crlf
# Zabbix export, data and docs stay LF.
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
# Plain-text repository files.
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
