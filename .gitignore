# Deny by default, allow by exception.
#
# Everything is ignored unless re-included below, so a new file stays out of git
# until it is added here on purpose: no editor backups, caches, test results,
# measurement output, local notes or captured data.
#
# Git descends only into re-included directories, and each of them needs its
# own "exclude everything, then allow" pair.

# --- repository root
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/CHANGELOG.md
!/agent/
!/template/
!/tests/

# --- collector and agent configuration
/agent/*
!/agent/edo-pki.ps1
!/agent/edo-pki-monitor.conf

# --- Zabbix template export
/template/*
!/template/*.yaml

# --- Pester tests and their fixtures
/tests/*
!/tests/*.Tests.ps1
!/tests/Helpers/
/tests/Helpers/*
!/tests/Helpers/*.psm1